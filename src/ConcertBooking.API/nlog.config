<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">
  <targets>
    <target xsi:type="Console" name="console">
      <layout xsi:type="JsonLayout" includeAllProperties="false">
        <attribute name="timestamp" layout="${date:format=o:universalTime=true}" />
        <attribute name="level" layout="${level:uppercase=true}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message}" />
        <attribute name="correlationId" layout="${event-properties:item=CorrelationId:whenEmpty=${scopeproperty:item=CorrelationId}}" />
      </layout>
    </target>
  </targets>
  <rules>
    <logger name="Microsoft.*" minlevel="Warning" writeTo="console" final="true" />
    <logger name="*" minlevel="Information" writeTo="console" />
  </rules>
</nlog>
